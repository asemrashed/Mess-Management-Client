# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Google OAuth (used to verify the Google ID token sent by the frontend)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Cron
CRON_SECRET="change-me-cron-secret"

# CORS
FRONTEND_URL="http://localhost:3000"

# Server
PORT=4000
NODE_ENV=development

# Email (SMTP) — used for verification, password reset, welcome, and reminder emails.
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, Amazon SES, Resend SMTP, etc).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password-or-app-password"
SMTP_FROM="MMS <no-reply@yourdomain.com>"

# Default timezone
DEFAULT_TIMEZONE="Asia/Dhaka"
